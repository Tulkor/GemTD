; Engine configuration file.
; Godot 4.3+

config_version=5

[application]

config/name="TD Hub"
config/description="Drei Tower-Defense-Spiele in einem: GemTD, eeveTD und Shopping Maul"
run/main_scene="res://scenes/main_menu.tscn"
config/icon="res://assets/icon/icon.png"
config/features=PackedStringArray("4.3", "GL Compatibility")
; Alter Speicherort (wie vor der Umbenennung zu TD Hub), damit Spielstände, XP und Einstellungen erhalten bleiben.
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/GemTD Nachbau"

[autoload]

Database="*res://scripts/autoload/database.gd"
Session="*res://scripts/autoload/session.gd"
Loc="*res://scripts/autoload/loc.gd"
Display="*res://scripts/autoload/display.gd"
Net="*res://scripts/autoload/net.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1400
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[gui]

timers/tooltip_delay_sec=0.1

[internationalization]

locale/fallback="de"
